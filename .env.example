# SAHAYAK AI — Environment Configuration Example
# Copy this file to .env for local development

# Frontend (Vite) Environment Variables
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional server-side AI provider configuration for Supabase Edge Functions or Local Proxy
# (Configure these in Supabase Dashboard -> Project Settings -> Edge Function Secrets)
AI_PROVIDER="gemini" # options: gemini, groq
GEMINI_API_KEY="AIzaSy..."
GROQ_API_KEY="gsk_..."

# Supabase Server-side Service Role (Never expose in browser!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

